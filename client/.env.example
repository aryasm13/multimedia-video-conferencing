# Client environment variables
# Copy this to .env and fill in the values

# URL of the backend server
# Local development: leave empty — the Vite dev server proxies /socket.io
# and /api to http://localhost:3000 (see vite.config.js)
VITE_SERVER_URL=

# Production example (replace with your deployed backend URL):
# VITE_SERVER_URL=https://your-backend.onrender.com

# Optional TURN relay server, for peers on networks that block direct
# peer-to-peer connections (symmetric NAT, strict firewalls, some mobile data).
# Several URLs can be comma-separated, e.g.
#   turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
